#profit <io>

fn greet(name: string) -> void {
    print("Hello,")
    print(name)
}

fn fib(n: int) -> int {
    if n < 2 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fn main() -> int {
    greet("Podex")
    let mut i = 0
    while i < 8 {
        print(fib(i))
        i = i + 1
    }
    return 0
}
